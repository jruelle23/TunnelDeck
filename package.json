{
  "name": "tunneldeck",
  "version": "2.1.2",
  "description": "Enables VPN support within Gaming Mode.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "clean": "shx rm -rf out && shx mkdir -p out/TunnelDeck",
    "stage": "shx cp -r dist backend plugin.json main.py package.json LICENSE README.md out/TunnelDeck",
    "zip": "python script/zip.py out/TunnelDeck out/tunneldeck-${npm_package_version}.zip",
    "prepackage": "npm run build",
    "package": "npm run clean && npm run stage && npm run zip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jruelle23/TunnelDeck.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "plugin-template",
    "steam-deck",
    "deck"
  ],
  "contributors": [
    {
      "name": "Benjamin Kohler",
      "email": "bkohler616@hotmail.com",
      "url": "https://github.com/bkohler616"
    },
    {
      "name": "Stephen Radford",
      "email": "steve228uk@gmail.com",
      "url": "https://twitter.com/steve228uk"
    },
    {
      "name": "Jeremy Ruelle",
      "email": "jeremy.ruelle23@hotmail.fr",
      "url": "https://github.com/jruelle23"
    }
  ],
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/jruelle23/TunnelDeck/issues"
  },
  "homepage": "https://github.com/jruelle23/TunnelDeck#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@types/react": "19.2.18",
    "rollup": "^4.62.4",
    "shx": "^0.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.12.0",
    "react-icons": "^5.7.0"
  }
}
